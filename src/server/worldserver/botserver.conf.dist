###################################################################################################
# BOTSERVER CONFIGURATION
#
# Settings of the player-bot subsystem (docs/playerbots/). Kept out of worldserver.conf on purpose:
# there are a lot of them. Copy this file to botserver.conf next to worldserver.conf and edit the copy;
# worldserver loads it right after worldserver.conf and the worldserver.conf.d directory. A key set in
# botserver.conf wins over the same key in worldserver.conf (so an old worldserver.conf keeps working).
# When there is no botserver.conf every setting keeps its default.
###################################################################################################

###################################################################################################
# BOT LOG DATABASE
#
#    BotLogDatabaseInfo
#        Description: Optional fifth database for the bot activity log (decisions, deaths, blocked
#                     quests...). Same format as the other *DatabaseInfo entries. Leave it commented
#                     out to disable bot logging. The schema is NOT created automatically: apply
#                     forever-botlog-setup.sql once. Never put the real password in a tracked file.
#        Example:     "<db-host>;3306;<botlog-user>;<password>;forever_botlog"
#
#    BotLog.MinSeverity
#        Description: Lowest severity written to the log: 0 trace, 1 info, 2 warn, 3 error.
#        Default:     1
#
#    BotLog.FlushIntervalMs
#        Description: Buffered events are written to the database in one batch this often (min 100).
#        Default:     1000
#
#    BotLog.MaxBatch
#        Description: Events buffered before an early flush is requested.
#        Default:     500
#

# BotLogDatabaseInfo = "<db-host>;3306;<botlog-user>;CHANGE_ME;forever_botlog"
# BotLogDatabase.WorkerThreads = 1
# BotLogDatabase.SynchThreads  = 1
BotLog.MinSeverity     = 1
BotLog.FlushIntervalMs = 1000
BotLog.MaxBatch        = 500
#
###################################################################################################

###################################################################################################
# PLAYER BOTS (work in progress, see docs/playerbots/)
#
#    Bot.Enabled
#        Description: Master switch for the player-bot subsystem (BotMgr). Gates whether
#                     BotMgr::Update is ticked from the world loop; when off, `bot spawn` refuses.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
#
#    Bot.Log.PosIntervalSec
#        Description: Position telemetry for the sim console map (table bot_pos in the bot log database, kept 2 days by default; retention
#                     is the third argument of botlog_roll_partitions3 in the daily event, not a config option). Every
#                     online bot is sampled at most once per this many seconds, and only when it moved more than 2 yards since its
#                     last sample; one extra sample is written on login and on map/zone change. 0 = off. Needs the bot log
#                     database (BotLogDatabaseInfo) and its bot_pos table (forever-botlog-setup.sql); read once at startup.
#        Default:     5
#
#    Bot.Log.PosIntervalSlowSec / Bot.Log.PosScaleBots
#        Description: Above PosScaleBots bots online the position sample interval grows to PosIntervalSlowSec (keeps bot_pos small
#                     with large populations). Re-evaluated every world tick.
#        Default:     15 / 500
#
#    Bot.Log.Categories
#        Description: Which kinds of bot events are written to the bot log database. Comma list read left to right: "all", "none",
#                     "name" (turn on), "-name" (turn off). A list starting with a plain name begins from none ("quest,dungeon"),
#                     one starting with "-name" begins from all ("-combat,-movement"). Categories: lifecycle, ai, combat, dummy,
#                     movement, travel, recovery, quest, progress, economy, pets, social, dungeon, other (an event no rule
#                     matches). The category comes from the event reason code prefix (e.g. DUNGEON_, TRAVEL_, PET_, QUEST_), then
#                     from the event type. Applies on top of BotLog.MinSeverity. Read once at startup.
#        Example:     "-combat,-movement" - everything except fights and walking.
#        Default:     all
#
#    Bot.Log.CategoryMinSeverity
#        Description: Severity floor per category, "name:level" comma list, level 0 trace, 1 info, 2 warn, 3 error. Keeps warnings
#                     and errors of a noisy category without its routine rows. Applies on top of BotLog.MinSeverity.
#        Example:     "combat:2,movement:2"
#        Default:     (empty, no floors)
#
#    Bot.Log.RepeatCap
#        Description: Identical repeating rows (quest_blocked, NO_PROGRESS, UNREACHABLE_TARGET, TEST_IDLE, TEST_IDLE_NOTE; same bot,
#                     type, reason, quest and target) written per login; the rest are counted and written as one LOG_SUPPRESSED row.
#                     0 = no cap.
#        Default:     3
#
#    Bot.Log.AiTickStatsSec
#        Description: Interval of the AI_TICK_STATS row (engine tick cost per state). 0 = off.
#        Default:     60
#
#    Bot.Log.ServerStatsSec
#        Description: Interval of the BOT_TICK_STATS line in the server log (server.worldserver): bots online, world update diff
#                     (avg/max ms) and BotMgr::Update cost (avg/max us) over the window. Works without the bot log database. Use it
#                     to compare runs at the same bot count (e.g. before/after a visibility or AI change). 0 = off.
#        Default:     60
#
#    Bot.Log.PullDetail
#        Description: 1 = COMBAT_START carries aggro_cause / aggro_range / pull_dist, COMBAT_SUMMARY carries fight_id, outcome and casts_ok.
#        Default:     1
#
#    Bot.Log.IdleReasons
#        Description: 1 = AI_TICK_STATS carries "no_action": ticks per engine on which no action ran, by reason (no_trigger,
#                     multiplied_to_zero, not_possible, not_useful, execute_failed). Needs Bot.Log.AiTickStatsSec > 0.
#        Default:     1
#
#    Bot.Log.BufferMax / Bot.Log.PosBufferMax
#        Description: Rows held in memory while the bot log database is slow or down. Over the cap rows are dropped and counted
#                     (an error is logged once; a log_dropped event with the counts is written when the database recovers).
#        Default:     200000 / 100000
#
#    Bot.Log.FlushRetries
#        Description: Re-submissions of a failed log batch before its rows are dropped and counted.
#        Default:     3
#
#    Bot.Log.ProbeIntervalSec
#        Description: Seconds between reachability probes (TCP connect to the BotLogDatabaseInfo host). When the host stops answering,
#                     bot logging is switched off (shown by `.bot status`) instead of letting the core DB layer abort the server on a
#                     failed reconnect; the probe switches it back on. 0 = no probing. Skipped for socket/"." hosts.
#        Default:     10
#
#    Bot.Log.HotSplit / Bot.Log.HotTypes
#        Description: 1 = event types in HotTypes (except COMBAT_SUMMARY/LOG_SUPPRESSED rows) are written to bot_event_hot (5 days
#                     retention) instead of bot_event (14 days). Needs the bot_event_hot table (forever-botlog-migrate-1.sql);
#                     query bot_event_all to see both. Ignored with a warning when the table does not exist.
#        Default:     0 / decision,state_change,trace,cast,aura
#
#
#    Bot.Population.Enabled
#        Description: Dynamic bot population. The number of pool bots (not alts) online follows a target: Base plus PerPlayerTenths/10
#                     bots per real player, scaled by the percentage of the hour in HourPct, clamped to Min..Max. Every IntervalSec the
#                     population moves towards the target by at most StepUp logins or StepDown logouts (nothing within Hysteresis bots
#                     of the target). Bots in combat or grouped with a real player are not logged out. New characters are created
#                     when too few exist. Logged out with the reason LOGOUT_POPULATION.
#        Default:     0 - Off
#
#    Bot.Population.Base / Bot.Population.PerPlayerTenths / Bot.Population.Min / Bot.Population.Max
#        Description: Bots wanted with no player online / extra bots per player in tenths (10 = one per player) / lower and upper limit.
#        Default:     100 / 0 / 0 / 200
#
#    Bot.Population.StepUp / Bot.Population.StepDown / Bot.Population.Hysteresis / Bot.Population.IntervalSec / Bot.Population.StartDelaySec
#        Description: Most logins per check / most logouts per check / tolerated distance from the target / seconds between checks /
#                     uptime before the first check.
#        Default:     5 / 3 / 2 / 60 / 60
#
#    Bot.Population.HourPct
#        Description: Up to 24 comma-separated percentages of the target for the hours 0-23 of server local time (missing hours repeat
#                     the last value). Empty = 100 for every hour. Example: "40,40,40,40,40,50,60,80,100".
#        Default:     ""
#
#    Bot.Login.MaxPerTick
#        Description: Bot logins started per world update tick (spreads a large `bot spawn`).
#        Default:     5

#    Bot.AI.Enabled
#        Description: Bot AI engine (Phase 2): every online bot gets an AI that is ticked from Player::Update on the map thread.
#                     With no strategies active a tick only tracks the engine state (non-combat/combat/dead) and logs changes.
#                     Can also be paused at runtime with the console command `bot ai on|off`.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
#
#    Bot.AI.TickMs
#        Description: Interval between AI ticks of one bot, in milliseconds (50-10000). Bots start at random offsets.
#        Default:     500
#
#    Bot.AI.TestStrategy
#        Description: New bots get the built-in test strategies (idle log, combat log, dead log). Off by default: they only prove
#                     the engine and write log rows. Strategies can also be toggled per bot with `bot strategy <name> +test_idle`.
#        Default:     0 - (Disabled)
#
#    Bot.AI.Test.IdleSec
#        Description: Seconds without any executed action before the test strategy's idle trigger fires.
#        Default:     30
#
#    Bot.AI.Test.CombatSec
#        Description: Interval in seconds of the test strategy's combat trigger while the combat engine is active.
#        Default:     5
#
#    Bot.AI.Default.NonCombat / Bot.AI.Default.Combat / Bot.AI.Default.Dead
#        Description: Comma separated strategies every new bot gets per engine (Phase 3 behaviors:
#                     goto, follow, stay, rest in the non-combat engine; recover in the dead engine).
#                     Strategies can be changed per bot at runtime with `bot strategy`.
#        Default:     "rest,goto,follow" / "combat" / "recover"
#
#    Bot.AI.Combat.Flee.Enabled / Bot.AI.Combat.Flee.LevelDiff / Bot.AI.Combat.EliteLevelBonus
#        Description: Basic combat strategy ("combat"). A bot attacked by mobs that are all too strong runs away
#                     (flee goal, logged as FLEE_LEVEL_DIFF) instead of fighting. Too strong = mob level minus bot
#                     level (+ EliteLevelBonus for elites/rare elites) above LevelDiff, or a world boss. Mobs that
#                     are not too strong are fought first. Flee off, MaxAttempts used up, or no navmesh path = fight back
#                     (FIGHT_TOO_STRONG). FLEE_START and COMBAT_END (bot_fled) carry flee_reason.
#        Default:     1 / 2 / 3
#
#    Bot.AI.Combat.Flee.MaxAttempts
#        Description: How many times per fight a bot may start fleeing before it fights back.
#        Default:     3
#
#    Bot.AI.Combat.Flee.LowHpPct
#        Description: A bot in a fight whose health falls below this percent runs away (flee_reason low_hp, counts
#                     against Flee.MaxAttempts; not when its target is nearly dead). 0 = off.
#        Default:     15
#
#    Bot.AI.Flee.Mode
#        Description: A/B switch for fleeing. 0 = current behaviour (flee from too-strong mobs and at low health).
#                     1 = aggro avoidance: quest and grind targets are capped at gap +1, no flee loop; once engaged the
#                     bot fights to the end (FIGHT_TOO_STRONG with why FLEE_MODE_FIGHT_TO_END). 2 = flee toward the
#                     nearest friendly guard within 120 yd (open-field flee when none). The active mode is logged as
#                     flee_mode in every combat decision row and in COMBAT_SUMMARY.
#        Default:     0
#
#    Bot.AI.Flee.AbPct / Bot.AI.Flee.AbMode
#        Description: Flee A/B in one run. The bots whose guid counter modulo 100 is below AbPct run flee mode AbMode
#                     (the experiment arm), all others run Bot.AI.Flee.Mode (the control). 0 = off, every bot runs
#                     Flee.Mode. The per-bot mode is logged as flee_mode in every combat row. Protocol:
#                     docs/playerbots/death-avoidance-20261008.md.
#        Default:     0 / 1
#
#    Bot.AI.Avoid.Entries / Bot.AI.Avoid.MaxLevelGap
#        Description: Creature entries that killed bots far above the expected rate (Defias Bandit 116, Young Forest
#                     Bear 822, Shadowgale Ursera 250927, Narg 79). Quest and grind target choice skips them (and
#                     skips targets standing next to them), and the combat target choice fights them last, unless
#                     the creature is at most MaxLevelGap levels above the bot (plain level difference, -1 = list
#                     off). Entries separated by comma, semicolon or space.
#        Default:     "116,822,250927,79" / 1
#
#    Bot.AI.Pull.FirstStrikeMargin / Bot.AI.Pull.RangedMaxYd
#        Description: Ranged classes (non-melee) open a quest or grind pull from the mob's own aggro radius plus
#                     FirstStrikeMargin yards (capped at RangedMaxYd, never below the normal ranged pull distance), so
#                     the mob does not get the first hit while the bot walks in. 0 = off. Melee classes are unchanged.
#        Default:     2 / 28
#
#    Bot.AI.AggroAvoid.Enabled
#        Description: Aggro awareness while a bot walks (goto/quest goals), stands idle or wants to eat/drink. Hostile
#                     elites and mobs above the bot's level are kept clear of: the bot detours around them, waits
#                     outside their aggro radius, or backs off when inside it, and never sits down to eat or drink
#                     inside their aggro range. Quest/grind targets next to such a mob are skipped. Each avoidance is
#                     logged as an AGGRO_AVOID decision (details: action, mob entry, level, elite, distance, aggro
#                     radius). 0 = off.
#        Default:     1
#
#    Bot.AI.AggroAvoid.MarginYards
#        Description: Yards kept clear on top of the mob's own aggro radius (which already scales with the level gap).
#        Default:     10
#
#    Bot.AI.AggroAvoid.MinLevelDiff / Bot.AI.AggroAvoid.Elites
#        Description: A mob is avoided when its level minus the bot level is at least MinLevelDiff (1 = any mob
#                     above the bot), and, with Elites on, whatever its level when it is an elite.
#        Default:     1 / 1
#
#    Bot.AI.AggroAvoid.LogIntervalSec
#        Description: At most one AGGRO_AVOID row per bot per this many seconds (the avoidance itself is not limited).
#        Default:     15
#
#    Bot.AI.AggroAvoid.MaxSec
#        Description: Seconds a goal may be held back by avoidance before it fails (path_fail AGGRO_BLOCKED), so the
#                     quest layer picks another goal.
#        Default:     45
#
#    Bot.AI.Grind.MaxLevelGap
#        Description: Grind targets may be at most this many effective levels above the bot (elites count
#                     +EliteLevelBonus). Grind targets also skip mobs with a gap >= 2 mob within 22 yd.
#        Default:     1
#
#    Bot.AI.Grind.MaxRadius
#        Description: Grind targets stay within this many yards of where the grind run began (the last quest area).
#                     When nothing is left inside, the anchor moves to the bot position. 0 = off.
#        Default:     150
#
#    Bot.AI.Combat.PrePullManaPct
#        Description: A mana user drinks before pulling when its mana is below this percent (the higher of this and
#                     Bot.AI.Rest.DrinkBelowPct applies).
#        Default:     40
#
#    Bot.AI.Combat.FreeTotems
#        Description: With Bot.AI.Rotation.Enabled a shaman that casts a totem (Stoneskin, Searing, Healing Stream) gets the totem tool
#                     (Earth, Fire, Water Totem) for free when the bags lack it. Placeholder until the economy phase.
#        Default:     1 - On
#
#    Bot.AI.Combat.FreeRepair
#        Description: A bot with a broken (0 durability) equipped item repairs everything for free (REPAIR_FREE) so
#                     weapon spells (Heroic Strike, Raptor Strike, Auto Shot) do not fail with EQUIPPED_ITEM_CLASS.
#        Default:     1
#
#    Bot.AI.Combat.Flee.MaxSec / Bot.AI.Combat.Flee.Yards
#        Description: Seconds a bot runs before it gives up and fights, and the distance of the flee destination.
#        Default:     10 / 35
#
#    Bot.AI.Combat.ApproachTimeoutSec
#        Description: A target the bot cannot get into range of within this many seconds is given up (APPROACH_TIMEOUT).
#        Default:     15
#
#    Bot.AI.Combat.HealBelowPct / Bot.AI.Combat.CasterRangePct
#        Description: Health percent below which a bot with a heal spell casts it on itself in combat; percent of the
#                     spell range at which casters/hunters stand while chasing their target.
#        Default:     45 / 80
#
#    Bot.AI.Rest.EatBelowPct / Bot.AI.Rest.DrinkBelowPct / Bot.AI.Rest.DonePct
#        Description: Health percent below which a bot out of combat sits and eats, mana percent below which it
#                     drinks, and the percent at which it stands up again.
#        Default:     60 / 40 / 95
#
#    Bot.AI.Rest.FreeFood
#        Description: Bots eat and drink without carrying food items (the vanilla food/drink spell for their level
#                     is applied). Placeholder until bots buy consumables (economy phase). 0 = bots only sit.
#        Default:     1
#
#    Bot.AI.Release.MinDelaySec / Bot.AI.Release.MaxDelaySec
#        Description: Random delay between a bot's death and releasing its spirit.
#        Default:     3 / 8
#
#    Bot.AI.Recover.MaxCorpseRunYards
#        Description: Ghosts whose corpse is farther away (or unreachable by path) use the spirit healer instead.
#        Default:     1200
#
#    Bot.AI.Move.StuckSec / Bot.AI.Move.StuckRepaths
#        Description: Seconds without getting closer to the goal before a stuck event, and how many such episodes
#                     (each re-issues the path) pass before the goal is given up (stuck/UNREACHABLE_TARGET).
#        Default:     8 / 3
#
#    Bot.AI.Death.CorpseRunMaxFails
#        Description: Failed corpse-run goals (and failed spirit healer walks) before the bot gives up: a failed corpse run
#                     falls back to the spirit healer, and when that fails too the bot is resurrected where it stands
#                     (decision CORPSE_RUN_GAVE_UP / SPIRIT_HEAL_GAVE_UP, logged once).
#        Default:     3
#
#    Bot.AI.Death.GiveUpSec
#        Description: Seconds a ghost may spend on the corpse run or the spirit healer walk (NO_PROGRESS /
#                     UNREACHABLE_TARGET retries included) before it is resurrected at the closest graveyard
#                     (decision CORPSE_RUN_TIMEOUT / SPIRIT_HEAL_TIMEOUT). The spirit healer give-up
#                     (SPIRIT_HEAL_GAVE_UP) now also respawns at the graveyard instead of in place. 0 = no time cap.
#        Default:     300

Bot.Enabled = 1
Bot.Log.PosIntervalSec = 5
Bot.Log.PosIntervalSlowSec = 15
Bot.Log.PosScaleBots = 500
Bot.Log.RepeatCap = 3
Bot.Log.AiTickStatsSec = 60
Bot.Log.ServerStatsSec = 60
Bot.Log.PullDetail = 1
Bot.Log.IdleReasons = 1
Bot.Log.BufferMax = 200000
Bot.Log.PosBufferMax = 100000
Bot.Log.FlushRetries = 3
Bot.Log.ProbeIntervalSec = 10
Bot.Log.HotSplit = 0
Bot.Log.HotTypes = "decision,state_change,trace,cast,aura"
Bot.Login.MaxPerTick = 5
Bot.Population.Enabled = 0
Bot.Population.Base = 100
Bot.Population.PerPlayerTenths = 0
Bot.Population.Min = 0
Bot.Population.Max = 200
Bot.Population.StepUp = 5
Bot.Population.StepDown = 3
Bot.Population.Hysteresis = 2
Bot.Population.HourPct = ""
Bot.Population.IntervalSec = 60
Bot.Population.StartDelaySec = 60
Bot.AI.Enabled = 1
Bot.AI.TickMs = 500
Bot.AI.TestStrategy = 0
Bot.AI.Test.IdleSec = 30
Bot.AI.Test.CombatSec = 5
Bot.AI.Default.NonCombat = "rest,goto,follow"

#
#    Bot.Quest.MaxActive
#        Description: Quests a bot keeps in its log before it only works and turns in.
#        Default:     12
#
#    Bot.Quest.StallSec
#        Description: Seconds without objective progress before a quest is dropped with a quest_blocked reason.
#        Default:     240
#
#    Bot.Quest.MaxMobLevelDiff
#        Description: Kill targets more than this many levels above the bot (elites count +Bot.AI.Combat.EliteLevelBonus) are skipped.
#        Default:     2
#
#    Bot.Quest.SelectRadius / Bot.Quest.FarRadius
#        Description: Yards searched for a quest giver (near pass, then far pass).
#        Default:     350 / 1500
#
#    Bot.Quest.SelectionBlockLogCap
#        Description: Maximum quest_blocked rows per bot written while choosing quests (nearby givers only).
#        Default:     40
#
#    Bot.Quest.HubBlacklistSec / Bot.Quest.HubScanSec
#        Description: Seconds one bot skips a hub it failed to reach (min 30) / minimum seconds between hub scans of one bot (min 5).
#        Default:     600 / 20
#
#    Bot.Quest.HubFailGlobalSec
#        Description: Seconds a hub that any bot failed to reach is skipped by ALL bots (min 60). When no hub fits the bot grinds (QUEST_HUB_NONE, QUEST_GRIND).
#        Default:     1800
#
#    Bot.Quest.HubMaxDist
#        Description: Hubs farther than this many yards are skipped unless a bot already reached them. Hubs in zones of the other faction are always skipped.
#        Default:     2500
#
#    Enable the quest behavior by adding "quest" to Bot.AI.Default.NonCombat (e.g. "rest,goto,follow,quest").
#

Bot.Quest.HubBlacklistSec = 600
Bot.Quest.HubScanSec = 20
Bot.Quest.HubFailGlobalSec = 1800
Bot.Quest.HubMaxDist = 2500
Bot.Quest.MaxActive = 12

#
#    Bot.AH.Enabled
#        Description: Bots list surplus non-stackable gear (green or better, not bound, no use to them) at an auctioneer and collect
#                     the mail (sold gold, returned items) at a mailbox. Auction calls run on the world thread.
#        Default:     0 - (Disabled)
#
#    Bot.AH.MaxListingsPerBot / Bot.AH.MaxListingsTotal
#        Description: Listings one bot may have at once / listings the house may hold before bots stop adding.
#        Default:     5 / 2000
#
#    Bot.AH.UndercutPct
#        Description: Price is 1.5 x the vendor sell price minus this percent, never below the sell price.
#        Default:     5
#
#    Bot.AH.VisitCooldownSec
#        Description: Seconds between two auction house or mailbox visits of one bot.
#        Default:     900
#

Bot.AH.Enabled = 0
Bot.AH.MaxListingsPerBot = 5
Bot.AH.MaxListingsTotal = 2000
Bot.AH.UndercutPct = 5
Bot.AH.VisitCooldownSec = 900
Bot.Quest.StallSec = 240
Bot.Quest.MaxMobLevelDiff = 2
Bot.Quest.SelectRadius = 350
Bot.Quest.FarRadius = 1500
Bot.Quest.SelectionBlockLogCap = 40
Bot.AI.Default.Combat = "combat"
Bot.AI.Default.Dead = "recover"
Bot.AI.Rest.EatBelowPct = 60
Bot.AI.Rest.DrinkBelowPct = 40
Bot.AI.Rest.DonePct = 95
Bot.AI.Rest.FreeFood = 1
Bot.AI.Release.MinDelaySec = 3
Bot.AI.Release.MaxDelaySec = 8
Bot.AI.Recover.MaxCorpseRunYards = 1200
Bot.AI.Move.StuckSec = 8
Bot.AI.Move.StuckRepaths = 3
Bot.AI.Death.CorpseRunMaxFails = 3
Bot.AI.Death.GiveUpSec = 300

#
#    Bot.AI.Pet.Enabled
#        Description: Hunter bots look after their pet: summon, revive, dismiss on logout and map change, feed, assist, follow,
#                     a basic ability set, and Taming the Beast quests. Adds the strategy "pet" to hunter bots.
#        Default:     0 - Off
#
#    Bot.AI.Pet.Feed / Bot.AI.Pet.Abilities / Bot.AI.Pet.Taming / Bot.AI.Pet.TameFirstPet
#        Description: Feed the pet by its happiness / set the autocast abilities of the pet / complete the Taming the Beast quests
#                     (needs Bot.AI.Pet.Enabled) / tame a first pet with Tame Beast when the hunter has none.
#        Default:     1 / 1 / 1 / 1
#
#    Bot.AI.Pet.MinLevel
#        Description: Level from which a hunter bot is expected to have a pet.
#        Default:     10
#
#    Bot.AI.Pet.FeedBelowPct / Bot.AI.Pet.MendBelowPct
#        Description: Feed the pet below this happiness percentage / cast Mend Pet below this health percentage.
#        Default:     66 / 60
#
#    Bot.AI.Pet.RetrySec / Bot.AI.Pet.TameCooldownSec
#        Description: Seconds between attempts to summon or revive a pet / pause after a failed tame attempt.
#        Default:     8 / 300
#
#    Bot.AI.Consumables.Enabled
#        Description: Bots drink healing and mana potions from their bags in a fight when health or mana is low and the class heal
#                     cannot help (instant potions the bot can use; food and drink stay with the rest strategy). Adds the strategy
#                     "consumables" to the Combat engine. Logged as POTION_HEALTH / POTION_MANA. Bots do not buy potions yet.
#        Default:     0 - Off
#
#    Bot.AI.Consumables.HealthBelowPct / Bot.AI.Consumables.ManaBelowPct
#        Description: Health percent / mana percent below which a potion is drunk in combat.
#        Default:     35 / 20
#
#    Bot.AI.Watchdog.Enabled
#        Description: Stall watchdog. A bot that makes no progress (no movement, xp, money or quest-log change; fighting, flying, being
#                     dead and instance content count as busy) is recovered in steps: clear the goal, use the hearthstone, teleport to
#                     the home bind. Adds the strategy "watchdog" to the NonCombat engine. Every step is logged (WATCHDOG_*).
#        Default:     0 - Off
#
#    Bot.AI.Watchdog.StallSec / Bot.AI.Watchdog.HearthMul / Bot.AI.Watchdog.HomeMul
#        Description: Seconds without progress before the goal is cleared / multiples of StallSec for the hearthstone and for the
#                     home teleport.
#        Default:     600 / 2 / 4
#
#    Bot.AI.Watchdog.Hearth / Bot.AI.Watchdog.Home
#        Description: Allow the hearthstone step / the home teleport step (off: only logged).
#        Default:     1 / 1
#
#    Bot.AI.Watchdog.MoveYards / Bot.AI.Watchdog.MaxPerHour
#        Description: Yards moved that count as progress / hearthstone and home recoveries per bot and hour (beyond it only
#                     WATCHDOG_EXHAUSTED is logged).
#        Default:     10 / 6
#
#    Bot.Loot.Roll.Enabled
#        Description: Bots vote in group loot rolls at once instead of leaving the roll to time out (60 s, which holds up the real
#                     players): Need on a gear upgrade their class can use (class-role gear score) and on items for an active quest,
#                     Greed on other items (see GreedOnOther), Pass when the bags are full. Needs no strategy.
#        Default:     0 - Off
#
#    Bot.Loot.Roll.GreedOnOther
#        Description: Greed on items the bot cannot use or does not need (it sells them later) instead of passing.
#        Default:     1
#
#    Bot.AI.Move.Natural.Enabled
#        Description: Natural-looking movement: smoother paths, human pacing, no repeated identical path requests, a step back or
#                     another route when stuck, light idling, and movement metrics. Adds the strategy "natural_idle".
#        Default:     0 - Off
#
#    Bot.AI.Move.Natural.Shortcut / Bot.AI.Move.Natural.RoundCorners / Bot.AI.Move.Natural.MaxShortcutYards
#        Description: Shorten paths where the walker can see straight ahead on solid ground / round sharp corners and use a smooth spline /
#                     longest straight leg a shortcut may create, in yards (10-120).
#        Default:     1 / 1 / 45
#
#    Bot.AI.Move.Natural.SpeedVariation / Bot.AI.Move.Natural.Pacing / Bot.AI.Move.Natural.Spread
#        Description: Slow per-bot drift of the walking speed (about 5 percent) / short pauses at start, arrival, after combat, after
#                     loot and at quest givers / a different approach point per bot and goal.
#        Default:     1 / 1 / 1
#
#    Bot.AI.Move.Natural.Idle / Bot.AI.Move.Natural.IdleMaxStandSec
#        Description: Look around, sit and wander a few yards while nothing else is to do / longest time a bot stands completely still (5-600).
#        Default:     1 / 25
#
#    Bot.AI.Move.Natural.Metrics / Bot.AI.Move.Natural.MetricsSec
#        Description: One decision row MOVE_METRICS per bot per window (turn rate, repeated legs, idle ratio, stuck count) / window length (10-3600).
#        Default:     1 / 60
#
#    Bot.AI.Dungeon.Enabled
#        Description: Dungeon groups of bots: composition (tank, healer, damage), readiness (rest, repair), pull choice, wipe
#                     recovery and run timeouts. See docs/playerbots/feature-bot-dungeon-groups-20261008.md.
#        Default:     0 - Off
#
#    Bot.AI.Dungeon.GroupSize / Bot.AI.Dungeon.Tanks / Bot.AI.Dungeon.Healers
#        Description: Places in the group (2-5) / how many go to tanks (0-2) / to healers (0-2); the rest are damage dealers.
#        Default:     5 / 1 / 1
#
#    Bot.AI.Dungeon.MaxLevelSpread / Bot.AI.Dungeon.MinLevel
#        Description: Highest minus lowest level allowed in one group, anchored on the leader / lowest level that is called at all.
#        Default:     4 / 15
#
#    Bot.AI.Dungeon.MinHealthPct / Bot.AI.Dungeon.MinManaPct / Bot.AI.Dungeon.MinHealerManaPct / Bot.AI.Dungeon.MinDurabilityPct
#        Description: The group rests before a pull until everybody has this much health, mana (healers: their own value), and
#                     goes to repair when somebody's durability is below the last value.
#        Default:     85 / 70 / 85 / 20
#
#    Bot.AI.Dungeon.MaxMobsPerPull / Bot.AI.Dungeon.MaxLevelOverGroup / Bot.AI.Dungeon.SkipPatrols
#        Description: Largest pack that is pulled (bosses excepted) / highest mob level above the group's average that is pulled /
#                     wait for a patrol to leave instead of pulling it.
#        Default:     4 / 2 / 1
#
#    Bot.AI.Dungeon.MaxWipes / Bot.AI.Dungeon.RunTimeoutMin
#        Description: Wipes after which the run is given up / minutes after which a bot-led run is given up.
#        Default:     3 / 90
#
#    Bot.AI.Dungeon.Map / Bot.AI.Dungeon.MaxLevel
#        Description: Map id of the dungeon the bots run (its entrance trigger is looked up in the area trigger table) / highest bot level
#                     taken along. One group runs at a time.
#        Default:     36 (Deadmines) / 25
#
#    Bot.AI.Dungeon.IntervalSec / Bot.AI.Dungeon.StartCooldownSec / Bot.AI.Dungeon.PackTimeoutSec
#        Description: Seconds between run updates / between two attempts to form a group / after which a pack that is not cleared is
#                     written off.
#        Default:     5 / 120 / 240
#
#    Bot.AI.Dungeon.ResurrectDelaySec / Bot.AI.Dungeon.FreeRepair
#        Description: Seconds after which dead members of a run are raised next to the tank once the fight is over (at once for a wipe,
#                     they come back at the entrance) / repair the group's gear when the run ends. Map = 0 picks the dungeon that fits the
#                     middle level of the online bots (raise Bot.AI.Dungeon.MaxLevel for that).
#        Default:     8 / 1
#
#    Bot.AI.Dungeon.PackLinkYards / Bot.AI.Dungeon.PackMaxMobs
#        Description: Spawns closer than this many yards (3D, chained) form one pack / larger packs without a boss are cut up.
#        Default:     14 / 6
#
#    Bot.AI.Ammo.Enabled
#        Description: Ranged ammo upkeep of the quest strategy's vendor layer: a bot with a bow, crossbow or gun equipped counts its arrows or
#                     bullets; below Bot.AI.Ammo.LowCount it logs AMMO_LOW, plans a vendor trip to a vendor that sells the right ammo and
#                     tops up to Bot.AI.Ammo.BuyTarget (AMMO_BOUGHT, AMMO_NO_MONEY, AMMO_NO_VENDOR, AMMO_BUY_FAILED). Needs a restart (vendor index).
#        Default:     0 - (Disabled)
#                     1 - (Enabled)
#
#    Bot.AI.Ammo.LowCount / Bot.AI.Ammo.BuyTarget / Bot.AI.Ammo.CooldownSec
#        Description: Trip threshold (rounds), top-up target (rounds) and minimum seconds between ammo trips of one bot.
#        Default:     60 / 400 / 300
#
#    Bot.AI.Travel.Enabled
#        Description: Travel and leveling progression. A bot that has outgrown its zone (or has nothing left to quest for) picks the next
#                     leveling zone for its level and faction, walks or flies there, and the quest strategy continues in the new zone.
#                     Flight masters close by are learned once and used for long trips; the hearthstone is used when the way from home is
#                     clearly shorter, and bots bind at inns they pass when that shortens the way back. Adds the strategy "travel".
#                     Boats and zeppelins are ridden as a simulated trip between two docks (the Deeprun Tram is not used).
#        Default:     0 - (Disabled)
#                     1 - (Enabled)
#
#    Bot.AI.Travel.Zones / Bot.AI.Travel.Taxi / Bot.AI.Travel.Transport / Bot.AI.Travel.Hearth
#        Description: Zone progression / flight paths (learn and use) / boats and zeppelins / hearthstone and inn binding. Each part can be
#                     switched off alone.
#        Default:     1 / 1 / 1 / 1
#
#    Bot.AI.Travel.CheckSec / Bot.AI.Travel.TripMinutes
#        Description: Seconds between two "does the zone still fit" checks (2-600) / longest time of one trip before it is abandoned (2-240).
#        Default:     10 / 25
#
#    Bot.AI.Travel.MaxRouteSteps / Bot.AI.Travel.RecentZones / Bot.AI.Travel.LeaveMarginLevels
#        Description: Longest planned route in legs (1-20) / zones a bot remembers so it does not bounce back (1-20) / levels above the
#                     zone's band before the bot leaves (0-10).
#        Default:     8 / 4 / 0
#
#    Bot.AI.Travel.DiscoverRadius
#        Description: Yards around a bot within which it visits flight masters it does not know yet (50-5000).
#        Default:     500
#
#    Bot.Talents.Premade.Enabled
#        Description: On level-up, learn a configured talent per tier for the bot's class (this fork has tiered talents: one pick per tier).
#                     Bot.Talents.Premade.Class.<classId> = comma list of Talent.db2 ids (first id of a tier wins, tiers that already hold a
#                     pick are left alone); Bot.Talents.Premade.Spec.<classId> = ChrSpecialization id to set when the bot has none (optional).
#                     Class ids: 1 warrior, 2 paladin, 3 hunter, 4 rogue, 5 priest, 7 shaman, 8 mage, 9 warlock, 11 druid. Empty = no-op.
#        Default:     0 - (Disabled)
#
#    Bot.AI.Rotation.Enabled
#        Description: Full class rotations: the conditional rows of the class spell table in BotCombat.cpp (Charge, Execute, Thunder
#                     Clap, Kick, Counterspell, Frost Nova, Power Word: Shield, Flame Shock, Life Tap, Hunter's Mark and more) are cast
#                     when their condition holds (area attacks against several mobs, interrupts, emergency cooldowns, no damage over
#                     time on a dying mob). Off: the bots cast the old fixed spells only. See
#                     docs/playerbots/feature-bot-class-rotations-20261008.md.
#        Default:     0 - Off
#
#    Bot.AI.Roles.Threat
#        Description: Needs Bot.AI.Roles.Enabled. A bot that is not the tank and whose threat on the fight target nears the pull limit
#                     over the tank's (110 percent in melee, 130 percent at range, acting at 90 percent of that) casts a threat reducer
#                     (Fade for priests, Feint for rogues) or, without one, stops attacking for 2.5 s. At most one action per 8 s.
#                     Logged as THREAT_REDUCE / THREAT_PAUSE.
#        Default:     1
#
#    Bot.AI.Rotation.CrowdControl
#        Description: With two or more mobs on the bot and none controlled yet, a control spell goes on the strongest mob that is not the
#                     fight target: Polymorph (mage), Shackle Undead (priest), Hibernate (druid), Banish (warlock), Scare Beast (hunter).
#                     Needs Bot.AI.Rotation.Enabled. Logged as CROWD_CONTROL.
#        Default:     1
#
#    Bot.AI.Roles.Enabled
#        Description: Group play in combat: a bot with a heal spell heals the group member who needs it most (an emergency first, then the
#                     tank, then the lowest health), and bots other than the tank (the warrior of the group) attack the tank's target.
#                     Only for bots that are in combat themselves. See docs/playerbots/feature-bot-group-roles-20261008.md.
#        Default:     0 - Off
#
#    Bot.AI.Roles.HoldSec
#        Description: A bot that is not the tank waits up to this many seconds for the tank to gather threat on a mob before it opens
#                     (shorter when the mob has turned to the tank, never when the mob attacks the bot). 0 = no waiting.
#                     Also in effect with Bot.AI.Roles.Enabled: bots join the fight of a group member within 45 yards, the warrior of
#                     the group holds Defensive Stance, taunts mobs that attack other members and applies Sunder Armor.
#        Default:     3
#
#    Bot.AI.Roles.AllyHealBelowPct / Bot.AI.Roles.TankHealBelowPct / Bot.AI.Roles.EmergencyPct
#        Description: Heal a group member below this health percent / the tank below this percent / below this percent a member is an
#                     emergency and comes first.
#        Default:     80 / 90 / 35
#
#
#    Bot.AI.Rotation.DruidForms
#        Description: Needs Bot.AI.Rotation.Enabled. Druids shift into Bear Form once they know it (level 10) and fight with Maul, Swipe and
#                     Demoralizing Roar; a bear that needs a heal leaves the form for Healing Touch. Off: druids stay unshifted casters.
#        Default:     0 - Off
#
#    Bot.AI.Rotation.DruidBear
#        Description: With Bot.AI.Rotation.DruidForms the druid fights in Bear Form (Dire Bear Form from level 40) instead of Cat Form. Off: Cat
#                     Form once known (level 20), Bear Form before that.
#        Default:     0 - Off
#
#    Bot.AI.Dummy.Enabled
#        Description: Training dummy mode: the chat verb "dummy [seconds]" makes a bot summon an immortal, harmless dummy of its own level and
#                     fight it with its normal combat code; "dummy off" ends the run. The log gets DUMMY_START and DUMMY_SUMMARY (damage per
#                     spell, dps, time to the first hit, longest gap without a hit). For tuning the class rotations (Bot.AI.Rotation.Enabled)
#                     without a sim run. Needs sql/custom/world/2026_10_08_04_world_forever_bot_dummy.sql. See
#                     docs/playerbots/feature-bot-dummy-20261008.md.
#        Default:     0 - Off
#
#    Bot.AI.Dummy.Entry / Bot.AI.Dummy.DefaultSec / Bot.AI.Dummy.MaxSec
#        Description: Creature entry of the dummy, run length without an argument, longest run a command may ask for (seconds).
#        Default:     9900001 / 60 / 600
#
#    Bot.AI.Dummy.FullPower
#        Description: Refill mana, energy and health every second during a run, so the numbers show the rotation and not the mana pool.
#        Default:     1 - On
#
#    Bot.AI.Loot.Improved.Enabled
#        Description: Improved chest loot task of the quest strategy: spawn choice by path cost, skip far spawns and recently deadly areas,
#                     per-bot spawn blacklist, bag-space check with a planned vendor trip, loot exits never feed the quest quarantine.
#                     Also: quest spawn index ignores pooled-out, phased, manual and other-difficulty spawns, quests that hand over their
#                     own items are supplied, and fewer locks and allocations per tick. Read once at startup.
#        Default:     0 - Off
#
#    Bot.AI.Loot.Improved.MaxYards
#        Description: Spawns farther than this (straight line or by path) are skipped (20-1000).
#        Default:     150
#
#    Bot.AI.Loot.Improved.DeadlyRadius / Bot.AI.Loot.Improved.DeadlySec
#        Description: Spawns within this many yards of a recent bot death are skipped for this many seconds.
#        Default:     40 / 600
#
#    Bot.AI.Loot.Improved.BlacklistSec
#        Description: A spawn that gave a bot no progress is skipped by that bot for this long; repeats double it.
#        Default:     900
#
#    Bot.AI.Loot.Improved.MinFreeSlots
#        Description: Plan a vendor trip when fewer free bag slots than this would remain after the loot.
#        Default:     2
#
#    Bot.AI.Loot.Improved.PathProbes
#        Description: Path queries per spawn choice (the nearest candidates are probed first).
#        Default:     4
#
#    Bot.AI.Loot.Safety.Enabled
#        Description: Guards of the chest loot task (independent of Bot.AI.Loot.Improved.Enabled): skip chests
#                     (the camp danger check of the quest strategy is separate and unchanged), skip chests near a recent bot death, and skip spawns
#                     that repeatedly failed bots for reasons that do not depend on the bot (no path, stalled approach, cannot interact).
#                     Every guard only skips or delays a chest. Read once at startup.
#        Default:     1 - On
#
#    Bot.AI.Loot.Safety.QuarantineStrikes / Bot.AI.Loot.Safety.QuarantineSec
#        Description: Bot-independent failures of one chest spawn within 30 minutes before every bot skips it / how long (doubles on
#                     repeats, up to 8 times).
#        Default:     3 / 1200
#

