#
#    Bot.Chat.Enabled
#        Description: Bots obey chat commands from the leader of their group (party, raid, whisper to a bot).
#                     Syntax: [selector] verb [args]; selectors: all, g1, g3-g4, g1,g3 (raid subgroups, read live),
#                     tank, healer, dps, or a class name; g1,g3 = union of subgroups, g1,tank = intersection (tanks inside subgroup 1). Party chat without selector = all bots of that party
#                     (in a raid: the issuer's subgroup); raid chat needs a selector.
#                     Verbs: follow, stay, goto <x y [z]|here>, rest, release, status, strategy [+name -name],
#                     verbose on|off. Anyone but the group leader is ignored and logged.
#        Default:     1 - Enabled
#
#    Bot.Chat.VerboseDefault
#        Description: Acknowledgements and refusals are sent back to the leader (aggregated, one line per
#                     command). Toggled per leader with the chat command "verbose on|off". Status always replies.
#        Default:     0 - Off
#
#    Bot.Chat.MaxReplyLines
#        Description: Maximum reply lines for status / strategy listings (1-10).
#        Default:     4
#
#    Bot.Chat.UnauthorizedLogSec
#        Description: Log at most one bot_event per issuer per this many seconds for non-leader attempts (0 = every one).
#        Default:     30
#
#    Bot.Chat.LogEvents
#        Description: Log a bot_event (type chat_command) per bot for every accepted or refused command.
#        Default:     1
#
#    Bot.Chat.GotoArriveYards
#        Description: Arrival distance of the "goto" chat command (1-50).
#        Default:     3
#
#    Bot.Chat.Role.Tank / Bot.Chat.Role.Healer / Bot.Chat.Role.Dps
#        Description: Comma separated class lists behind the tank, healer and dps selectors. They also gate the
#                     orders pull (tank classes only) and heal (healer classes only).
#        Default:     "warrior" / "priest" / "rogue,mage,warlock,hunter"
#
#    Bot.Chat.Orders.Enabled
#        Description: More chat verbs (docs/playerbots/feature-bot-chat-orders-20261008.md): stop, aggressive,
#                     passive, pull (tank bots attack the leader's selected target), heal (healer bots heal
#                     the selected target), mount, dismount, summon (bots port to the leader), revive (dead
#                     bots come back to life next to the leader). Off: these words are ordinary chat.
#        Default:     0 - Off
#
#    Bot.Chat.Orders.PullRangeYards / Bot.Chat.Orders.HealRangeYards
#        Description: Farthest distance from the bot to the selected target for pull (5-150) and heal (5-100;
#                     the heal spell's own range applies as well).
#        Default:     60 / 40
#
#    Bot.Chat.Orders.ReviveHealthPct / Bot.Chat.Orders.ReviveSickness
#        Description: Health percent (1-100) of a bot revived with the revive order, and whether it gets
#                     resurrection sickness (from the level the core gives it). Ignored on Classic.Hardcore realms,
#                     where revive is refused.
#        Default:     35 / 1
#
Bot.Chat.Enabled = 1
Bot.Chat.VerboseDefault = 0
Bot.Chat.MaxReplyLines = 4
Bot.Chat.UnauthorizedLogSec = 30
Bot.Chat.LogEvents = 1
Bot.Chat.GotoArriveYards = 3
Bot.Chat.Role.Tank = "warrior"
Bot.Chat.Role.Healer = "priest"
Bot.Chat.Role.Dps = "rogue,mage,warlock,hunter"
Bot.Chat.Orders.Enabled = 0
Bot.Chat.Orders.PullRangeYards = 60
Bot.Chat.Orders.HealRangeYards = 40
Bot.Chat.Orders.ReviveHealthPct = 35
Bot.Chat.Orders.ReviveSickness = 1
#
#    Bot.Alt.Enabled
#        Description: Players may log in characters of their own account as bots (".bot alt add|remove|list <name>").
#                     Never while the character is online as a player; a bot character cannot log in as a player.
#                     Alts are remembered across a restart when Bot.Alt.Persist is on. The group leader controls them like other bots.
#        Default:     1 - Enabled
#
#    Bot.Alt.MaxPerAccount
#        Description: Maximum alt bots logged in at the same time per account (protects the tick budget).
#        Default:     4
#
#    Bot.Alt.Persist
#        Description: Remember alt bots (table bot_alt in the characters database, see forever-characters-bot-alt.sql) and log
#                     them in again at startup. Disables itself with one log line when the table does not exist.
#        Default:     1 - Enabled
#
#    Bot.Alt.Default.NonCombat
#        Description: Non-combat strategies of an alt bot at login (comma separated). Alts idle until commanded: no quest or
#                     grind AI by default. A group leader command (e.g. "quest on") adds strategies.
#        Default:     "rest,follow,goto"
#
#    Bot.Invite.Enabled
#        Description: Bots accept party invites from players. Alt bots accept only invites of their owner account;
#                     world bots accept any invite the core did not refuse (ignore, faction, already grouped).
#        Default:     1 - Enabled
#
#    Bot.Trade.Enabled
#        Description: Bots react to trade requests. Alt bots trade only with their owner account (the bot accepts a
#                     non-empty offer and gives nothing); world bots refuse every trade. Trades left open time out.
#        Default:     1 - Enabled
#
#    Bot.Trade.TimeoutSeconds
#        Description: Seconds a trade opened towards an alt bot may stay open before the bot cancels it (10-600).
#        Default:     90
#
#    Bot.Trade.Link.Enabled
#        Description: Trading items with the bots of your group by whisper. After a trade window opens, the bot whispers
#                     the items it can give (tradable stacks of its bags: never equipped, soulbound or quest items) as
#                     item links. Whisper it the links of the ones you want and it puts the largest stack of each in the
#                     window; confirm and the bot accepts. World bots of your own group may trade this way too (otherwise
#                     they refuse every trade); alt bots stay limited to their owner account. Needs Bot.Trade.Enabled.
#        Default:     0 - Disabled
#
#    Bot.Trade.Link.MaxListed
#        Description: Items in the bot's whispered list (1-40); the best quality and the largest stacks come first.
#        Default:     15
#
#    Bot.Social.QuestShare.LogEach
#        Description: Log one quest_share bot_event per receiver of a bot's quest share. Off: one summary row per share
#                     command (accepted count, refused count per reason); "verbose on" of the issuer also logs each receiver.
#        Default:     0 - Disabled
#
Bot.Alt.Enabled = 1
Bot.Alt.MaxPerAccount = 4
Bot.Alt.Persist = 1
Bot.Alt.Default.NonCombat = "rest,follow,goto"
Bot.Invite.Enabled = 1
Bot.Trade.Enabled = 1
Bot.Trade.TimeoutSeconds = 90
Bot.Trade.Link.Enabled = 0
Bot.Trade.Link.MaxListed = 15
Bot.Social.QuestShare.LogEach = 0
#
###################################################################################################
